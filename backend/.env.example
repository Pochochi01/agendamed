# ---- Servidor ----
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agendamed

# ---- JWT ----
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_este_secreto_por_uno_aleatorio_largo
JWT_EXPIRES_IN=8h

# ---- Cifrado de credenciales de terceros ----
# Clave con la que se cifran los access token de MercadoPago de cada medico.
# Si se deja vacia se usa JWT_SECRET (cambiarlo obligaria a recargarlos).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRED_SECRET=

# ---- MercadoPago ----
# IMPORTANTE: estas credenciales son de LA PLATAFORMA y se usan solo para
# cobrar la suscripcion mensual a los medicos.
# El cobro de los TURNOS usa las credenciales propias de cada profesional,
# que el mismo carga desde su panel (/medico/cobros) y se guardan cifradas.
# Un medico sin credenciales no ofrece pago online: sus turnos se confirman
# directamente al reservarse.
# Credenciales de prueba: https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
# URL publica que MercadoPago usa para el webhook (usar ngrok en desarrollo)
MP_WEBHOOK_URL=http://localhost:4000/api/pagos/webhook

# ---- Negocio ----
# Canon mensual que paga cada medico a la plataforma
SUSCRIPCION_MONTO=15000
# Antelacion recomendada para cancelar, en horas. NO bloquea: el paciente
# siempre puede cancelar. Solo se usa para avisarle que esta cancelando sobre
# la hora y para destacar esa cancelacion en el registro que ve el medico.
CANCELACION_HORAS_RECOMENDADAS=24

# A partir de cuantas cancelaciones previas se marca al paciente en la agenda
# del medico (fondo rojo). Es "mas de N": con 2, se marca al tercer turno.
CANCELACIONES_ALERTA=2
