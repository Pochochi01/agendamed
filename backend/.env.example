# ---- Servidor ----
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# URL publica del sitio, usada para armar los enlaces que se COMPARTEN
# (el de agendamiento /reservar/... y los retornos de MercadoPago).
#
# Si se deja vacia, el servidor la deduce del dominio con el que llego la
# request (detras de Nginx sale bien automaticamente) y cae a FRONTEND_URL
# como ultimo recurso.
#
# Conviene definirla en produccion para que nunca dependa de las cabeceras:
# PUBLIC_URL=https://tudominio.com
PUBLIC_URL=

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agendamed

# ---- JWT ----
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_este_secreto_por_uno_aleatorio_largo
JWT_EXPIRES_IN=8h

# ---- Cifrado de credenciales de terceros ----
# Clave con la que se cifran los access token de MercadoPago de cada medico.
# Si se deja vacia se usa JWT_SECRET (cambiarlo obligaria a recargarlos).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRED_SECRET=

# ---- MercadoPago ----
# IMPORTANTE: estas credenciales son de LA PLATAFORMA y se usan solo para
# cobrar la suscripcion mensual a los medicos.
# El cobro de los TURNOS usa las credenciales propias de cada profesional,
# que el mismo carga desde su panel (/medico/cobros) y se guardan cifradas.
# Un medico sin credenciales no ofrece pago online: sus turnos se confirman
# directamente al reservarse.
# Credenciales de prueba: https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
# URL publica que MercadoPago usa para el webhook (usar ngrok en desarrollo)
MP_WEBHOOK_URL=http://localhost:4000/api/pagos/webhook

# ---- Transcripcion del dictado (historia clinica) ----
# El audio llega completo al terminar la grabacion, se transcribe de una sola
# pasada y se DESCARTA. Nunca se guarda en disco ni en la base de datos.
#
#   local   -> Whisper corriendo en este servidor (@xenova/transformers).
#              El audio NO sale de la maquina: es lo recomendado para datos
#              clinicos. Necesita CPU: en un VPS de 1 vCPU puede tardar varias
#              veces la duracion del audio.
#   externo -> API compatible con OpenAI. Mucho mas rapido, pero el audio del
#              paciente viaja a un tercero. Requiere TRANSCRIPCION_API_KEY.
TRANSCRIPCION_PROVEEDOR=local

# --- Proveedor local ---
# Modelos, de mas rapido a mas preciso:
#   Xenova/whisper-tiny  (~40 MB)  rapido, menos preciso
#   Xenova/whisper-base  (~80 MB)  equilibrio recomendado
#   Xenova/whisper-small (~250 MB) mejor con terminologia medica, mas lento
TRANSCRIPCION_MODELO_LOCAL=Xenova/whisper-base
# true descarga y carga el modelo al arrancar, para que el primer dictado no
# tenga que esperar. Alarga el arranque del servidor.
TRANSCRIPCION_PRECARGAR=false

# --- Proveedor externo (solo si TRANSCRIPCION_PROVEEDOR=externo) ---
TRANSCRIPCION_API_URL=https://api.openai.com/v1
TRANSCRIPCION_API_KEY=
TRANSCRIPCION_MODELO_EXTERNO=whisper-1

# --- Comunes ---
TRANSCRIPCION_IDIOMA=spanish
TRANSCRIPCION_IDIOMA_ISO=es
TRANSCRIPCION_MAX_MB=20
TRANSCRIPCION_TIMEOUT_MS=120000

# ---- Negocio ----
# Canon mensual que paga cada medico a la plataforma
SUSCRIPCION_MONTO=15000
# Antelacion recomendada para cancelar, en horas. NO bloquea: el paciente
# siempre puede cancelar. Solo se usa para avisarle que esta cancelando sobre
# la hora y para destacar esa cancelacion en el registro que ve el medico.
CANCELACION_HORAS_RECOMENDADAS=24

# A partir de cuantas cancelaciones previas se marca al paciente en la agenda
# del medico (fondo rojo). Es "mas de N": con 2, se marca al tercer turno.
CANCELACIONES_ALERTA=2
