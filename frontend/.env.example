# URL de la API. En desarrollo se deja vacia/comentada para usar el proxy de
# Vite (ver vite.config.js), que evita problemas de CORS.
# VITE_API_URL=http://localhost:4000/api

# Clave publica de MercadoPago (solo si se integra el Brick de pago embebido;
# el flujo actual usa Checkout Pro y redirige, asi que no es obligatoria).
# VITE_MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
